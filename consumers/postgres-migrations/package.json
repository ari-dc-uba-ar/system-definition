{
  "name": "@system-definition/postgres-migrations",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL migration consumer for system-definition artifacts",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && mocha --exit --node-option enable-source-maps \"dist/test/*-test.js\"",
    "test-ci": "tsc && c8 mocha --exit --node-option enable-source-maps \"dist/test/*-test.js\"",
    "test-integration": "npm run build && npm --prefix ../.. run build:examples && node scripts/test-integration.js && node scripts/test-authoring-integration.js && node scripts/test-conflict-resolution-integration.js && node scripts/test-cli-integration.js",
    "docs:generate": "node scripts/generate-readme.js",
    "docs:check": "node scripts/generate-readme.js --check",
    "prebuild": "npm run bootstrap-repository",
    "pretest": "npm run bootstrap-repository",
    "pretest-ci": "npm run bootstrap-repository",
    "bootstrap-repository": "node scripts/bootstrap-repository.js"
  },
  "dependencies": {
    "system-definition": "file:../..",
    "pgsql-parser": "18.2.10",
    "pg": "8.23.1",
    "esbuild": "0.28.2"
  },
  "bin": {
    "postgres-migrations": "dist/src/cli-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./validation": {
      "types": "./dist/src/historical-validation.d.ts",
      "default": "./dist/src/historical-validation.js"
    },
    "./package.json": "./package.json"
  }
}
